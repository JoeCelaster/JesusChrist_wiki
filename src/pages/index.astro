<style>
  body {
    margin: 0;
    min-height: 100vh;
    background: #faf9f6;
    color: #000000ff;
    font-family: "Gilda Display", serif;
    -webkit-font-smoothing: antialiased;
  }

  main {
    box-sizing: border-box;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
    text-align: center;
  }

  .cross {
    color: #000000ff;
    font-size: 2rem;
    margin-bottom: 1.5rem;
  }

  .eyebrow {
    color: #000000ff;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    line-height: 1.8;
  }

  h1 {
    margin: 1rem 0;
    font-size: clamp(2.4rem, 7vw, 4.5rem);
    font-weight: 400;
    letter-spacing: -0.035em;
  }

  h1 span {
    color: #000000ff;
  }

  .description {
    max-width: 34rem;
    color: #000000ff;
    font-size: 1.15rem;
    line-height: 1.3;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2rem;
    padding: 0.2rem 1rem;
    border: 1px solid #e7e3da;
    border-radius: 999px;
    color: #000000ff;
    font-size: 0.95rem;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #8c754a;
  }

  footer {
    margin-top: 4rem;
    color: #000000ff;
    font-size: 0.9rem;
  }
</style>
